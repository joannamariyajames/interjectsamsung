# Copy to .env (git-ignored) and fill in. All free accounts.
# LiveKit Cloud (Settings -> Keys): the benchmark agent and inference script
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# FDB-v3 benchmark agent (LK_PROVIDER=nvidia, the default of scripts/run_fdb_v3.sh):
# speech-to-text on Groq, the tool-calling LLM on NVIDIA's free API catalog
GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional: Gemini Live (LK_PROVIDER=gemini3_8)
GEMINI_API_KEY=
